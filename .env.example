# API Keys
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
# Gemini model for OCR (src/ocr) + PDF precheck (A6). gemini-2.0-flash was shut down
# 2026-06-01 — use 2.5. Flash = balance precio/calidad (visión); Flash-Lite = más barato.
GEMINI_MODEL=gemini-2.5-flash

# Database — dev comparte docker-compose del backend (puerto 5433), prod usa Neon mismo branch que back
DATABASE_URL=postgresql://postgres:innova_secret@localhost:5433/innova_dev_db

# MongoDB — dev comparte docker-compose del backend (puerto 27017), prod usa Atlas mismo cluster base innova_ai_engine
MONGODB_URI=mongodb://root:innova_mongo_secret@localhost:27017/innova_ai_engine_local?authSource=admin

# AWS
AWS_REGION=us-east-1
SQS_LLM_CLASSIFY_ARN=arn:aws:sqs:us-east-1:<account-id>:innova-backend-serverless-prod-llm-classify-queue
SQS_OCR_QUEUE_ARN=arn:aws:sqs:us-east-1:<account-id>:innova-backend-serverless-prod-ocr-queue

# v9 guides pipeline — A6 guide_ingest_worker
SQS_GUIDE_INGEST_ARN=arn:aws:sqs:us-east-1:<account-id>:innova-backend-serverless-prod-guide-ingest-queue
SQS_SOLUTION_GEN_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/innova-backend-serverless-prod-solution-generation-queue
S3_GUIDES_BUCKET=innova-backend-serverless-prod-guides
SSM_GUIDES_INGEST_PAUSED_PARAM=/innova/guides/ingest_paused
GUIDE_INGEST_CHUNK_PAGES=20
GUIDE_INGEST_CHUNK_OVERLAP=1
GUIDE_MIN_EXTRACTION_QUALITY=0.5

# v9 guides pipeline — A7 solution_generator
# SQS_SOLUTION_GEN_ARN is the trigger (A6 publishes to SQS_SOLUTION_GEN_URL, same queue).
SQS_SOLUTION_GEN_ARN=arn:aws:sqs:us-east-1:<account-id>:innova-backend-serverless-prod-solution-generation-queue
SSM_GUIDES_SOLUTION_PAUSED_PARAM=/innova/guides/solution_paused
SOLUTION_GEN_USE_BATCHES=true
SOLUTION_TOPIC_MIN_CONFIDENCE=0.85

# v9 guides pipeline — A8 submission_grader
SQS_SUBMISSION_GRADE_ARN=arn:aws:sqs:us-east-1:<account-id>:innova-backend-serverless-prod-submission-grade-queue
SQS_ATTEMPT_REPROCESS_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/innova-backend-serverless-prod-attempt-reprocess-queue
S3_SUBMISSIONS_BUCKET=innova-backend-serverless-prod-submissions
SSM_GUIDES_GRADING_PAUSED_PARAM=/innova/guides/grading_paused
SSM_GUIDES_CHEAP_MODE_PARAM=/innova/guides/grading_cheap_mode
GRADING_MIN_TRANSCRIPTION_CONFIDENCE=0.5

# v9 guides pipeline — A10 adhoc_solver (scan without guide context)
SQS_ADHOC_SOLVE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/innova-backend-serverless-prod-adhoc-solve-queue

# M11 / A9.2 hourly_alerts — detector thresholds (EventBridge cron, no queue/bucket).
# Defaults shown; tune in prod via env without redeploying code.
ALERT_AT_RISK_PKNOWN_FLOOR=0.4
ALERT_AT_RISK_MIN_TOPICS=3
ALERT_TOPIC_STRUGGLE_RATIO=0.5
ALERT_STUDENT_DROP_TREND=-0.15
ALERT_UNIT_OFF_TRACK_FLOOR=0.4
ALERT_GUIDE_COMPLETE_RATIO=0.9
ALERT_GUIDE_COMMON_ERROR_RATIO=0.3

# Settings
LOG_LEVEL=info
OCR_CONFIDENCE_THRESHOLD=0.7
LLM_BATCH_SIZE=20
SSM_LLM_PAUSED_PARAM=/innova/llm/paused
SSM_OCR_PAUSED_PARAM=/innova/ocr/paused
