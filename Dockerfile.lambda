FROM public.ecr.aws/lambda/python:3.11

ARG LAMBDA_NAME=llm-classifier
ENV LAMBDA_NAME=${LAMBDA_NAME}

COPY pyproject.toml ./
RUN pip install uv && uv pip install --system --no-cache \
    anthropic google-generativeai scipy numpy pydantic pydantic-settings \
    structlog asyncpg boto3 httpx

COPY src/ ./src/

CMD ["src.pipeline.llm_consumer.handler"]
